# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history

# CI/CD credentials — never commit
scripts/.ci_credentials.env
scripts/secrets.env
secrets-db.env
*.env
nul

# Google API keys — never commit
android/app/google-services.json
android/app/google-services.json.backup
ios/Runner/GoogleService-Info.plist
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated localisations. `flutter pub get` regenerates these from
# lib/l10n/*.arb because pubspec sets `generate: true`, so committing them
# only creates merge conflicts and drift against the ARB source of truth.
lib/l10n/app_localizations*.dart

# Bible DB generator output (25 MB, served over HTTP, never bundled)
tools/build/
