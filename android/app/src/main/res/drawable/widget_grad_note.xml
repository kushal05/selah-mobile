<?xml version="1.0" encoding="utf-8"?>
<!-- Notes action tile: purple gradient with decorative circles (texture
     matching the home dashboard's daily-focus / overview cards). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/widget_grad_note_start"
                android:endColor="@color/widget_grad_note_end" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:width="56dp"
        android:height="56dp"
        android:gravity="top|right"
        android:top="-16dp"
        android:right="-16dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_texture_strong" />
        </shape>
    </item>
    <item
        android:width="38dp"
        android:height="38dp"
        android:gravity="bottom|left"
        android:bottom="-12dp"
        android:left="-12dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_texture_soft" />
        </shape>
    </item>
    <item
        android:width="22dp"
        android:height="22dp"
        android:gravity="bottom|right"
        android:bottom="14dp"
        android:right="16dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_texture_soft" />
        </shape>
    </item>
</layer-list>
