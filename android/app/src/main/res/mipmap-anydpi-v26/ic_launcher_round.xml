<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ shapes the icon itself (circle, squircle, rounded square) from
     these layers, and Android 13+ draws the monochrome layer in the user's
     theme colour. Without them the launcher shrank the old square image,
     white corners and all, into a white shape of its own. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
